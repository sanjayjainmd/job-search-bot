# ---------- Notifications ----------
# Telegram (leave blank to disable). Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (leave blank to disable). Gmail requires an App Password, not your login password.
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ---------- LLM scoring (optional but recommended) ----------
# Any OpenAI-compatible endpoint. Leave LLM_API_KEY blank to disable scoring;
# the bot still runs and sends everything that passes the keyword filters.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---------- Apify (optional; off by default) ----------
# See jobbot/sources/apify.py — you must supply working Actor IDs first.
APIFY_TOKEN=
APIFY_WELLFOUND_ACTOR=
APIFY_YC_ACTOR=

# ---------- Behaviour ----------
# DRY_RUN=true prints the digest to the console instead of sending it.
DRY_RUN=true
