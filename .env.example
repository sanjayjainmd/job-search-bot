# ---------- Notifications ----------
# Telegram (leave blank to disable). Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (leave blank to disable). Gmail requires an App Password, not your login password.
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ---------- LLM scoring (optional but recommended) ----------
# Claude, via console.anthropic.com. Leave blank to disable scoring; the bot
# still runs and sends everything that passes the keyword filters.
# Haiku 4.5 is the cheapest current Claude model and the right tier for this:
# about $0.22 to score the whole starting backlog, then pennies a month.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# ---------- Apify (optional; off by default) ----------
# See jobbot/sources/apify.py — you must supply working Actor IDs first.
APIFY_TOKEN=
APIFY_WELLFOUND_ACTOR=
APIFY_YC_ACTOR=

# ---------- Behaviour ----------
# DRY_RUN=true prints the digest to the console instead of sending it, and does
# not mark anything as seen. Keep this TRUE locally once the cloud runner owns
# real sending - the GitHub Actions workflow sets DRY_RUN=false itself, so local
# testing never needs to send.
DRY_RUN=true
